function drawLib(){const q=(document.getElementById('q').value||'').toLowerCase(),t=document.getElementById('type').value,c=document.getElementById('core').checked;let arr=DATA.filter(x=>(!q||(x.vi+x.es).toLowerCase().includes(q))&&(!t||x.type===t)&&(!c||CORE.has(x.id))).slice(0,250);document.getElementById('lib').innerHTML=`<div class="tableWrap"><table class="tbl"><thead><tr><th>#</th><th>Tiếng Việt</th><th>Español</th><th>Phiên âm cho người Việt</th><th>Loại</th><th>Tiến độ</th><th></th></tr></thead><tbody>${arr.map(x=>`<tr><td>${x.id}</td><td class="vi">${esc(x.vi)}</td><td class="es">${esc(x.es)}</td><td class="phon">${esc(phon(x))}</td><td>${esc(x.type)}</td><td>${dots(S(x.id).level)}</td><td><button class="btn sm" onclick="openPhrase(${x.id})">Mở</button> ${audioBtn(x,'🔊')}</td></tr>`).join('')}</tbody></table></div><div class="muted" style="margin-top:7px">${arr.length} kết quả đang hiển thị.</div>`}
function toggleAccent(){APP.accent=APP.accent==='ES'?'LATAM':'ES';save();render()}
function review(){const n=due().length;document.getElementById('view').innerHTML=header('Ôn tập thông minh','Nhớ lại trước khi xem đáp án.')+`<div class="grid g3"><div class="card metric"><label>Đến hạn</label><strong>${n}</strong><span>hôm nay</span></div><div class="card metric"><label>Lỗi</label><strong>${Object.values(APP.states).reduce((a,s)=>a+s.bad,0)}</strong><span>tổng</span></div><div class="card metric"><label>Lượt ôn</label><strong>${Object.values(APP.states).reduce((a,s)=>a+s.ok+s.bad,0)}</strong><span>đã ghi</span></div></div><div class="card flashShell" style="text-align:center"><h3>${n?'Có nội dung cần ôn':'Không có mục đến hạn'}</h3><p class="muted">${n?'Bắt đầu với tối đa 30 mục.':'Có thể học trước 10 mục lõi mới.'}</p><button class="btn primary" onclick="startReview()">${n?'Bắt đầu ôn':'Học 10 mục mới'}</button></div>`}
function pronView(){const candidates=DATA.filter(x=>CORE.has(x.id)&&((x.notes||[]).length||S(x.id).level>0)).slice(0,80);document.getElementById('view').innerHTML=header('Phát âm cho người Việt','Phiên âm là cầu nối; trọng âm và vị trí miệng mới là mục tiêu.',`<button class="btn" onclick="toggleAccent()">${APP.accent==='ES'?'🇪🇸 Tây Ban Nha':'🌎 Mỹ Latinh'}</button>`)+`<div class="card"><h3>Quy ước phiên âm</h3><div class="legend"><div><b>CHỮ HOA</b><br>Âm tiết được nhấn mạnh: ma-<b>ÑA</b>-na.</div><div><b>r</b><br>Chạm đầu lưỡi một lần, cực nhanh.</div><div><b>rr</b><br>Rung đầu lưỡi mạnh.</div><div><b>kh</b><br>j / g(e,i) tiếng Tây Ban Nha.</div><div><b>nh</b><br>ñ gần “nh” tiếng Việt.</div><div><b>th</b><br>c/z giọng Spain: đầu lưỡi giữa hai răng.</div><div><b>y</b><br>ll/y, gần âm d/gi miền Nam.</div><div><b>h</b><br>Thường câm.</div><div><b>b/v</b><br>Thường nghe rất gần nhau.</div></div></div><div class="title"><h3>Drill phát âm</h3></div><div class="dayItems">${candidates.slice(0,30).map(phraseCard).join('')}</div>`}
function practice(){document.getElementById('view').innerHTML=header('Thực hành giao tiếp','Biến kiến thức thành phản xạ.')+`<div class="grid g3">${[['Nhà hàng','Gọi món, hỏi, sửa món, trả tiền.'],['Làm quen','Hỏi 5 điều, chia sẻ 3 điều về mình.'],['Di chuyển','Địa điểm, chỉ đường, điểm dừng.'],['Vấn đề','Giải thích vấn đề + giải pháp mong muốn.'],['Công việc','Giải thích công việc trong 2 phút.'],['Ý kiến','Ý kiến + lý do + nhưng + ví dụ.']].map((x,i)=>`<div class="card"><h3>${x[0]}</h3><p class="muted">${x[1]}</p><button class="btn" onclick="logPractice('${x[0]}')">Bắt đầu 10 phút</button></div>`).join('')}</div><div class="title"><h3>Ghi phút nói</h3></div><div class="card"><div class="filters"><input id="mins" type="number" class="input" value="10" min="1"><button class="btn primary" onclick="addMin()">+ Ghi phút</button></div></div>`}
function errorsView(){const arr=DATA.map(x=>({x,s:S(x.id)})).filter(z=>z.s.bad).sort((a,b)=>b.s.bad-a.s.bad).slice(0,30);document.getElementById('view').innerHTML=header('Lỗi của tôi','Sai nhiều = ưu tiên cao hơn học mới.')+`<div class="card">${arr.length?arr.map(z=>`<div class="red"><div><b>${esc(z.x.vi)}</b><div class="es">${esc(z.x.es)}</div></div><div class="phon">${esc(phon(z.x))}</div><div><span class="badge">${z.s.bad} lỗi</span><button class="btn sm" onclick="openPhrase(${z.x.id})">Luyện</button></div></div>`).join(''):'<div class="empty">Chưa có lỗi. Làm flashcards/test để hệ thống phát hiện.</div>'}</div>`}
function progressView(){const core=DATA.filter(x=>CORE.has(x.id));document.getElementById('view').innerHTML=header('Tiến bộ','Theo dõi năng lực thật, không theo XP.')+`<div class="grid g4"><div class="card metric"><label>Đã học lõi</label><strong>${learned(core)}</strong><span>/600</span></div><div class="card metric"><label>Tự động</label><strong>${automatic(core)}</strong><span>phản xạ nhanh</span></div><div class="card metric"><label>Phút nói</label><strong>${APP.minutes.reduce((a,x)=>a+x.min,0)}</strong><span>đã ghi</span></div><div class="card metric"><label>Mức chức năng</label><strong style="font-size:22px">${funcLabel()}</strong><span>${funcScore()}/100</span></div></div><div class="title"><h3>Kiểm tra kỹ thuật</h3></div><div class="card" id="selfTest"></div>`;runSelfTest()}
function mineView(){document.getElementById('view').innerHTML=header('Câu của tôi','Thêm câu bạn thật sự cần trong đời sống.')+`<div class="grid g2"><div class="card"><label class="muted">Tiếng Việt</label><input id="mvi" class="input" style="width:100%;margin:5px 0 10px"><label class="muted">Español</label><input id="mes" class="input" style="width:100%;margin:5px 0 10px"><label class="muted">Phiên âm của bạn</label><input id="mph" class="input" style="width:100%;margin:5px 0 10px"><button class="btn primary full" onclick="addMine()">+ Lưu câu</button></div><div class="card"><h3>${APP.my.length} câu cá nhân</h3><p class="muted">Nên thêm câu đã cần ít nhất 2 lần hoặc được người bản xứ sửa.</p><button class="btn" onclick="exportData()">Xuất tiến độ JSON</button></div></div><div class="title"><h3>Danh sách</h3></div><div class="card">${APP.my.length?APP.my.map((x,i)=>`<div class="red"><div><b>${esc(x.vi)}</b><div class="es">${esc(x.es)}</div></div><div class="phon">${esc(x.phon)}</div><button class="btn sm" onclick="APP.my.splice(${i},1);save();mineView()">Xóa</button></div>`).join(''):'<div class="empty">Chưa có câu cá nhân.</div>'}</div>`}
function openPhrase(id){const x=item(id);document.getElementById('modal').classList.add('open');document.getElementById('modalKicker').textContent=x.category;document.getElementById('modalTitle').textContent=x.vi;document.getElementById('modalSteps').innerHTML='';document.getElementById('modalBody').innerHTML=`<div class="card flash"><div class="vi" style="font-size:22px">${esc(x.vi)}</div><div class="answer"><div class="es">${esc(x.es)}</div><div class="phon">${esc(phon(x))}</div>${(x.notes||[]).length?`<div class="note">${x.notes.map(esc).join('<br>')}</div>`:''}<div class="actions">${audioBtn(x,'🔊 Nghe tiếng Tây Ban Nha')}<button class="btn" onclick="toggleReal(${id});openPhrase(${id})">${S(id).real?'✓ Đã dùng thật':'Đánh dấu đã dùng thật'}</button></div></div></div><div class="card" style="margin-top:10px"><label class="muted">Sửa phiên âm theo cách bạn dễ đọc hơn</label><input id="customP" class="input" style="width:100%;margin:7px 0" value="${esc(APP.customPhon[id]||'')}"><button class="btn" onclick="saveCustomPhon(${id})">Lưu phiên âm riêng</button></div>`}
function saveCustomPhon(id){const v=document.getElementById('customP').value.trim();if(v)APP.customPhon[id]=v;else delete APP.customPhon[id];save();openPhrase(id);toast('Đã lưu phiên âm')}
function closeModal(){document.getElementById('modal').classList.remove('open')}window.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()})
function toggleReal(id){S(id).real=!S(id).real;save()}function completeDay(d){APP.daily[d]=Object.assign(APP.daily[d]||{},{done:true,date:today()});save();toast(`Đã hoàn thành Ngày ${d}`);dayView(d)}function logPractice(t){APP.minutes.push({date:today(),min:10,type:t});save();toast('Đã ghi 10 phút thực hành')}function addMin(){const m=+document.getElementById('mins').value||0;if(m){APP.minutes.push({date:today(),min:m,type:'nói'});save();toast('Đã ghi phút nói')}}
function addMine(){const vi=document.getElementById('mvi').value.trim(),es=document.getElementById('mes').value.trim();if(!vi||!es){toast('Cần tiếng Việt và Español');return}APP.my.push({vi,es,phon:document.getElementById('mph').value.trim()});save();mineView()}
function exportData(){const b=new Blob([JSON.stringify(APP,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='espanol30-progreso.json';a.click();URL.revokeObjectURL(a.href)}
function startReview(){reviewQ=(due().length?due().slice(0,30):DATA.filter(x=>CORE.has(x.id)&&!S(x.id).seen).slice(0,10));reviewI=0;flashModal('Ôn tập')}
function startFlash(d){reviewQ=dayItems(d);reviewI=0;flashModal(`Ngày ${d} · Flashcards`)}function startPronDay(d){reviewQ=dayItems(d).filter(x=>(x.notes||[]).length).slice(0,5);if(reviewQ.length<5)reviewQ=dayItems(d).slice(0,5);reviewI=0;pronModal(`Ngày ${d} · Phát âm`)}function startTestDay(d){reviewQ=dayItems(d).sort(()=>Math.random()-.5).slice(0,10);reviewI=0;flashModal(`Ngày ${d} · Test 10`)}
function flashModal(title){document.getElementById('modal').classList.add('open');document.getElementById('modalKicker').textContent='VI → ES';document.getElementById('modalTitle').textContent=title;document.getElementById('modalSteps').innerHTML='';drawFlash()}
function drawFlash(){const x=reviewQ[reviewI];if(!x){closeModal();toast('Đã lưu kết quả');render();return}document.getElementById('modalBody').innerHTML=`<div class="muted" style="text-align:center">${reviewI+1}/${reviewQ.length}</div><div class="card flash"><div class="prompt">${esc(x.vi)}</div><p class="muted">Nói tiếng Tây Ban Nha trước khi xem đáp án.</p><button class="btn" onclick="reveal()">Xem đáp án</button><div id="ans" class="answer hidden"><div class="es">${esc(x.es)}</div><div class="phon">${esc(phon(x))}</div>${audioBtn(x,'🔊 Nghe chuẩn')}</div></div><div id="grades" class="grades hidden"><button class="grade" onclick="grade(0)">Không biết</button><button class="grade" onclick="grade(1)">Khó</button><button class="grade" onclick="grade(2)">Biết</button><button class="grade" onclick="grade(3)">Tự động</button></div>`}
function reveal(){document.getElementById('ans').classList.remove('hidden');document.getElementById('grades').classList.remove('hidden')}function grade(g){const x=reviewQ[reviewI],s=S(x.id),d=today();s.seen++;s.last=d;if(g===0){s.bad++;s.level=Math.max(1,s.level-1);s.next=d}else if(g===1){s.ok++;s.level=Math.max(1,s.level);s.next=plus(d,1)}else if(g===2){s.ok++;s.level=Math.max(3,s.level);s.next=plus(d,3)}else{s.ok++;s.level=Math.max(4,s.level);s.next=plus(d,s.level>=5?14:7)}save();reviewI++;drawFlash()}
function pronModal(title){document.getElementById('modal').classList.add('open');document.getElementById('modalKicker').textContent='PHÁT ÂM';document.getElementById('modalTitle').textContent=title;document.getElementById('modalSteps').innerHTML='';drawPron()}
function drawPron(){const x=reviewQ[reviewI];if(!x){closeModal();toast('Hoàn thành drill phát âm');return}document.getElementById('modalBody').innerHTML=`<div class="muted" style="text-align:center">${reviewI+1}/${reviewQ.length}</div><div class="card flash"><div class="vi">${esc(x.vi)}</div><div class="es" style="font-size:31px;margin-top:16px">${esc(x.es)}</div><div class="phon" style="font-size:21px;margin-top:10px">${esc(phon(x))}</div>${(x.notes||[]).length?`<div class="note">${x.notes.map(esc).join('<br>')}</div>`:''}<div class="actions">${audioBtn(x,'🔊 Nghe 3 lần')}<button class="btn" onclick="pronNext(1)">Cần luyện thêm</button><button class="btn primary" onclick="pronNext(2)">Ổn</button></div></div>`}
function pronNext(ok){const x=reviewQ[reviewI],s=S(x.id);s.seen++;if(ok===2){s.ok++;s.level=Math.max(s.level,2)}else{s.bad++}save();reviewI++;drawPron()}
function startDay(d){session={day:d,stage:0,idx:0,queue:[],listen:0,start:Date.now()};document.getElementById('modal').classList.add('open');document.getElementById('modalKicker').textContent=`NGÀY ${d}/30`;document.getElementById('modalTitle').textContent=PLAN[d-1].label;stage()}
function stepBar(){document.getElementById('modalSteps').innerHTML=['Ôn','20 mục','Phát âm','Sản xuất','Nhiệm vụ'].map((_,i)=>`<i class="${i<=session.stage?'on':''}"></i>`).join('')}
function stage(){stepBar();if(session.stage===0){session.queue=due().slice(0,10);session.idx=0;stageIntro('Khởi động','Ôn nhanh nội dung đến hạn.',()=>stageFlash())}else if(session.stage===1){session.queue=dayItems(session.day);session.idx=0;stageIntro('20 mục hôm nay','Tiếng Việt → Español → phiên âm.',()=>stageFlash())}else if(session.stage===2){session.queue=dayItems(session.day).filter(x=>(x.notes||[]).length).slice(0,5);if(session.queue.length<5)session.queue=dayItems(session.day).slice(0,5);session.idx=0;stageIntro('Phát âm','Tập trung trọng âm + âm khó.',()=>stagePron())}else if(session.stage===3){session.queue=dayItems(session.day).sort(()=>Math.random()-.5).slice(0,8);session.idx=0;stageIntro('Sản xuất','Chỉ nhìn tiếng Việt và tự nói tiếng Tây Ban Nha.',()=>stageFlash())}else{document.getElementById('modalBody').innerHTML=`<div class="card"><small class="muted">NHIỆM VỤ THỰC TẾ</small><h2>${esc(PLAN[session.day-1].focus)}</h2><p class="muted">Nói ít nhất 10 phút. Dùng ít nhất 5 câu của hôm nay. Nếu thiếu từ, mô tả vòng thay vì đổi sang ngôn ngữ khác.</p><label><input id="missionDone" type="checkbox"> Tôi đã hoàn thành nhiệm vụ</label><br><button class="btn primary" style="margin-top:15px" onclick="finishDaySession()">Lưu và kết thúc</button></div>`}}
function stageIntro(t,p,fn){document.getElementById('modalBody').innerHTML=`<div class="card" style="text-align:center;padding:38px"><h2>${t}</h2><p class="muted">${p}</p><button id="go" class="btn primary">Bắt đầu</button></div>`;document.getElementById('go').onclick=fn}
function stageFlash(){const x=session.queue[session.idx];if(!x){session.stage++;stage();return}document.getElementById('modalBody').innerHTML=`<div class="muted" style="text-align:center">${session.idx+1}/${session.queue.length}</div><div class="card flash"><div class="prompt">${esc(x.vi)}</div><p class="muted">Nói Español.</p><button class="btn" onclick="sReveal()">Xem</button><div id="sans" class="answer hidden"><div class="es">${esc(x.es)}</div><div class="phon">${esc(phon(x))}</div>${audioBtn(x)}</div></div><div id="sgrades" class="grades hidden"><button class="grade" onclick="sGrade(0)">Không biết</button><button class="grade" onclick="sGrade(1)">Khó</button><button class="grade" onclick="sGrade(2)">Biết</button><button class="grade" onclick="sGrade(3)">Tự động</button></div>`}
function sReveal(){document.getElementById('sans').classList.remove('hidden');document.getElementById('sgrades').classList.remove('hidden')}function sGrade(g){const x=session.queue[session.idx],s=S(x.id),d=today();s.seen++;if(g===0){s.bad++;s.level=Math.max(1,s.level-1);s.next=d}else if(g===1){s.ok++;s.next=plus(d,1);s.level=Math.max(1,s.level)}else if(g===2){s.ok++;s.next=plus(d,3);s.level=Math.max(3,s.level)}else{s.ok++;s.next=plus(d,7);s.level=Math.max(4,s.level)}save();session.idx++;stageFlash()}
function stagePron(){const x=session.queue[session.idx];if(!x){session.stage++;stage();return}document.getElementById('modalBody').innerHTML=`<div class="muted" style="text-align:center">${session.idx+1}/${session.queue.length}</div><div class="card flash"><div class="vi">${esc(x.vi)}</div><div class="es" style="font-size:30px;margin-top:15px">${esc(x.es)}</div><div class="phon" style="font-size:20px;margin-top:8px">${esc(phon(x))}</div>${(x.notes||[]).length?`<div class="note">${x.notes.map(esc).join('<br>')}</div>`:''}<div class="actions">${audioBtn(x,'🔊 Nghe')}<button class="btn primary" onclick="session.idx++;stagePron()">Tiếp</button></div></div>`}
function finishDaySession(){const d=session.day,mins=Math.max(1,Math.round((Date.now()-session.start)/60000));APP.daily[d]=Object.assign(APP.daily[d]||{},{done:document.getElementById('missionDone').checked,date:today()});APP.minutes.push({date:today(),min:mins,type:'study'});save();closeModal();toast(`Đã lưu Ngày ${d} · ${mins} phút`);route(`day/${d}`)}
function funcScore(){const core=DATA.filter(x=>CORE.has(x.id));const l=pct(learned(core),600),a=pct(automatic(core),600),mins=Math.min(100,APP.minutes.reduce((s,x)=>s+x.min,0)/15);return Math.round(l*.4+a*.4+mins*.2)}function funcLabel(){const s=funcScore();return s<25?'A1 khởi động':s<45?'A1+ / A2 bắt đầu':s<65?'A2 chức năng':s<82?'A2 cao / B1 bắt đầu':'B1 giao tiếp'}
function runSelfTest(){const tests=[];tests.push(['1.000 mục',DATA.length===1000]);tests.push(['30 ngày',PLAN.length===30]);tests.push(['20 mục/ngày',DAY_IDS.length===30&&DAY_IDS.every(x=>x.length===20)]);tests.push(['600 mục không trùng',new Set(DAY_IDS.flat()).size===600]);tests.push(['17 mô-đun',MODULES.length===17]);tests.push(['Route ngày 1–30',Array.from({length:30},(_,i)=>DAY_IDS[i]&&DAY_IDS[i].every(id=>!!item(id))).every(Boolean)]);document.getElementById('selfTest').innerHTML=tests.map(t=>`<div class="${t[1]?'testOK':'testBad'}">${t[1]?'✓':'✕'} ${t[0]}</div>`).join('')}
initAudio().then(()=>render());if(!location.hash)location.hash='#/home';else render();
</script></body></html>
